# Copiez ce fichier en .env (ignoré par git) et collez votre clé gratuite : https://aistudio.google.com/apikey
# Sert à estimer les calories et les glucides des repas (onglet Repas). Sans clé, tout le reste fonctionne.
GEMINI_API_KEY=

# Capteur FreeStyle Libre 3 via LibreLinkUp (services/device/librelinkup.py). Compte de SUIVI LibreLinkUp, pas celui de LibreLink.
# Région : FR, EU, EU2, DE, US, CA, AE, AP, AU, JP, LA, RU.
LIBRELINKUP_EMAIL=
LIBRELINKUP_PASSWORD=
LIBRELINKUP_REGION=FR
